# ============================================================
# LOCAL DEVELOPMENT TEMPLATE -- copy this to .env for local dev:
#   copy .env.example .env      (PowerShell/cmd)
#   cp .env.example .env        (bash)
#
# Every value below points at a LOCAL, DISPOSABLE container (see
# docker-compose.yml) or is otherwise safe for a laptop. Production
# credentials (the real Supabase/Postgres URL, real API keys) live ONLY
# in the deployment platform's dashboard (Render env vars -- see
# render.yaml) and must never be pasted into this file or committed.
# The backend also prints which database host it's actually connected to
# on every startup -- check that line before doing anything against a
# database you can't afford to break.
# ============================================================

# Neo4j Settings (local container -- see `docker-compose.yml`'s neo4j
# service; optional, run with `docker compose --profile neo4j up -d`)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Backend API Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Local Postgres container (see `docker-compose.yml`'s postgres service --
# `docker compose up -d postgres`). Matches that service's
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB exactly; change all three
# together if you ever change them.
DATABASE_URL=postgresql://nexustrace:localdevpassword@localhost:5432/nexustrace_dev

# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to the Vite dev server if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth Settings (required -- backend refuses to start without this)
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Seeds the 3 demo RBAC accounts (see docs/HOW_TO_RUN_AND_USE.md) on
# startup. Local dev only -- leave unset/false in any deployed environment.
DEMO_MODE=true

# LLM API Settings (Gemini / OpenAI) -- optional, needed for real
# entity/relationship extraction from uploaded documents.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Sarvam AI Document AI (Digitise) -- required for OCR on uploaded/webcam-
# captured document images (.jpg/.png). Get a key from
# https://dashboard.sarvam.ai (API Keys section) -- save it immediately,
# the dashboard only shows it once at creation time.
SARVAM_API_KEY=

# Pipeline Settings
DATA_DIR=./data
PROCESSED_DIR=./data/processed
