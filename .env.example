# Neo4j Settings
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Backend API Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./nexustrace.db
# Comma-separated list of origins allowed to call the API (CORS).
# Defaults to the Vite dev server if unset.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth Settings (required — backend refuses to start without this)
# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# LLM API Settings (Gemini / OpenAI)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Pipeline Settings
DATA_DIR=./data
PROCESSED_DIR=./data/processed
